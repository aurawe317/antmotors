# Dependencies
node_modules/
.npm/

# Secrets — never commit credentials, even to a private repo
server/config.json
server/alipay.config.json
server/antmotors.db
server/antmotors.db-*

# Local runtime data
.workbuddy/
.workbuddy-data/
data/
.tmp/
*.log

# Native prototype mirrors — they are rebuilt from app/index.html at deploy time
# (ignore everything under native/, but keep the root Capacitor config so the
#  antoto.app server URL survives a fresh clone / CI rebuild — it is read by
#  `npx cap sync`, not generated by it)
native/*
!native/capacitor.config.json

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Test scratch
test-auth.js
